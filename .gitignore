memory_f/
brain/memories/
logs/
*.log
*.sqlite
*.sqlite-journal
config/seed.json
config/ollama.json
config/voice_map.json
servers/openamika-iot/devices.json
servers/openamika-iot/scenes.json
avatar/stage/
tests/output/
controls_verification.json

# ── Environments created by the README (conda create -p envs\<name>) ──
envs/

# ── Large model weights and licensed assets (bring your own / download) ──
speech/models/*
!speech/models/DOWNLOAD.md
avatar/models/*
!avatar/models/README.md

# ── Third-party stacks you install next to OpenAmika (never part of this repo) ──
